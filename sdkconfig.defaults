# Target: ESP32-WROOM (dual-core, 4 MB flash, no PSRAM)
CONFIG_IDF_TARGET="esp32"

# CPU: run at full 240 MHz for headroom during 100 Hz sampling + Wi-Fi
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Wi-Fi softAP (HTTP transfer mode)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# FreeRTOS tick at 1000 Hz for finer task timing granularity
CONFIG_FREERTOS_HZ=1000

# Memory-saving lwIP / Wi-Fi tuning (frees internal RAM for the sample buffer)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
